# --- App ---
APP_NAME=AI Document Q&A API
ENVIRONMENT=development
DEBUG=true

# --- Security ---
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ragdb

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_TTL_SECONDS=900

# --- AI Providers ---
LLM_PROVIDER=openai        # openai | groq | ollama
EMBEDDING_PROVIDER=cohere  # openai | google | cohere | ollama
# NOTE: document_chunks.embedding is sized for 768 dimensions (see
# EMBEDDING_DIM in app/models/document.py), matching Ollama's
# nomic-embed-text. If you switch providers (openai/google=1536-dim,
# cohere=1024-dim), update EMBEDDING_DIM and apply a matching Alembic
# migration first -- otherwise the app will refuse to start (see
# app/core/startup_checks.py). This pairing has drifted out of sync twice
# already as new migrations were added; when adding another embedding
# migration, update this default and comment in the same commit.

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=models/embedding-001

COHERE_API_KEY=
COHERE_EMBEDDING_MODEL=embed-english-v3.0

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- RAG ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5
LLM_TEMPERATURE=0

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=/app/storage/documents

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
