# --- App ---
APP_NAME=AI Document Q&A API
ENVIRONMENT=development
DEBUG=true

# --- Security ---
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ragdb

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_TTL_SECONDS=900

# --- AI Providers ---
LLM_PROVIDER=openai        # openai | groq | ollama
EMBEDDING_PROVIDER=openai  # openai | google | ollama

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- RAG ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5
LLM_TEMPERATURE=0

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=/app/storage/documents

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
